---
import BaseHead from "../components/BaseHead.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { SITE_DESCRIPTION, SITE_TITLE, terminalConfig } from "../consts";
import fileSystemData from "../data/fileSystem.json" assert { type: "json" };

// Build welcome message (no ASCII art)
const welcomeLines = [
  `Welcome to ${terminalConfig.username}'s terminal.`,
  `Type 'help' to see available commands.`,
  `Type 'docs' to visit my knowledge base.`,
  `Use ls/cd/cat to browse docs directly.`,
];

// Serialize config for client-side
const clientConfig = {
  username: terminalConfig.username,
  hostname: terminalConfig.hostname,
  welcomeMessage: welcomeLines,
  // Static md files (copied to public/md/ by scripts/build-fs.js)
  mdBaseUrl: import.meta.env.BASE_URL.replace(/\/?$/, '/') + 'md/',
  // MkDocs site base for resolving image/asset links inside md files
  docsBaseUrl: import.meta.env.DEV ? 'http://127.0.0.1:8000/note/docs/' : 'https://dezliu.github.io/note/docs/',
  customCommands: Object.fromEntries(
    Object.entries(terminalConfig.customCommands).map(([key, val]) => [
      key,
      {
        description: val.description,
        output: typeof val.output === 'function' ? '__function__' : val.output,
        action: val.action,
        target: val.target,
      }
    ])
  ),
  fileSystem: fileSystemData,
};
---

<!doctype html>
<html lang="en" data-theme="light">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<div
			class="min-h-screen flex flex-col"
			style={{
				backgroundColor: "var(--theme-background)",
				color: "var(--theme-text)",
			}}
		>
			<Header />
			<!-- Terminal area -->
			<div
				id="terminal-container"
				class="font-mono overflow-y-auto h-[calc(100vh-160px)] p-2 sm:p-4"
				style="text-align:left;background-color:var(--theme-background);color:var(--theme-text);font-family:var(--theme-fontFamily);font-size:var(--theme-fontSize);"
			>
				<!-- Command output area -->
				<div id="terminal-output" class="space-y-1"></div>
				<!-- Input prompt -->
				<div id="input-line" class="space-y-1 mt-1">
					<div style="color:var(--theme-promptUser)">╭─{terminalConfig.username}@{terminalConfig.hostname} <span id="cwd-display" style="color:var(--theme-info)">~</span></div>
					<div style="color:var(--theme-promptUser)">╰─<span style="color:var(--theme-promptSymbol)">$ </span>
						<input
							id="terminal-input"
							type="text"
							autofocus
							autocomplete="off"
							spellcheck="false"
							class="bg-transparent border-none outline-none"
							style="color:var(--theme-text);font-family:inherit;font-size:inherit;"
						/>
					</div>
				</div>
			</div>

			<!-- Preview Modal -->
			<div id="preview-modal" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4" style="background-color:rgba(0,0,0,0.5);">
				<div class="relative w-full max-w-4xl max-h-[85vh] flex flex-col" style="background-color:var(--theme-background);border:1px solid var(--theme-border);border-radius:8px;">
					<!-- Modal header -->
					<div class="flex items-center justify-between px-4 py-3" style="border-bottom:1px solid var(--theme-border);">
						<span id="preview-filename" class="font-bold text-sm" style="color:var(--theme-primary);"></span>
						<button id="preview-close" title="Close (Esc)" class="px-3 py-1 text-sm rounded hover:opacity-75" style="color:var(--theme-muted);border:1px solid var(--theme-border);cursor:pointer;">✕ Esc</button>
					</div>
					<!-- Modal content -->
					<div id="preview-content" class="overflow-y-auto p-4 flex-1 min-h-0 prose" style="color:var(--theme-text);"></div>
				</div>
			</div>

			<Footer />
		</div>
	</body>
</html>

<script define:vars={{ config: clientConfig }}>
const tc = config;
const JOKES = [
  "Why do programmers prefer dark mode? Because light attracts bugs!",
  "How many programmers does it take to change a light bulb? None, that's a hardware problem!",
  "Why do Java developers wear glasses? Because they can't C#!",
  "There are only 10 types of people in the world: those who understand binary and those who don't.",
  "A SQL query goes into a bar, walks up to two tables and asks: 'Can I join you?'"
];

let history = [];
let histIdx = -1;

// Tab completion cycling state
let tabState = null;

// Vi mode state (set -o vi)
let viMode = 'insert';
let viPending = '';

// Virtual file system state
let cwd = ''; // current working directory path (empty = root)
let cwdStack = []; // for tracking navigation history

const $ = (id) => document.getElementById(id);
const output = () => $("terminal-output");
const container = () => $("terminal-container");
const inputEl = () => $("terminal-input");
const cwdDisplay = () => $("cwd-display");

// File system helpers
function resolvePath(pathStr) {
  if (!pathStr || pathStr === '~') return '';
  // ~/xxx or /xxx are absolute from root; otherwise relative to cwd
  let base;
  let rest = pathStr;
  if (rest.startsWith('~/')) {
    base = [];
    rest = rest.slice(2);
  } else if (rest.startsWith('/')) {
    base = [];
    rest = rest.replace(/^\/+/, '');
  } else {
    base = cwd.split('/').filter(Boolean);
  }
  // Normalize segments: handle . and .. anywhere in the path
  for (const seg of rest.split('/')) {
    if (!seg || seg === '.') continue;
    if (seg === '..') { base.pop(); continue; }
    base.push(seg);
  }
  return base.join('/');
}

function findNode(path) {
  if (!path) return tc.fileSystem;
  const parts = path.split('/').filter(Boolean);
  let node = tc.fileSystem;
  for (const part of parts) {
    if (!Array.isArray(node)) return null;
    const child = node.find(n => n.name === part);
    if (!child) return null;
    node = child.type === 'dir' ? child.children : child;
  }
  return node;
}

function getCwdDisplay() {
  if (!cwd) return '~';
  return '~/'.concat(cwd);
}

function updateCwdDisplay() {
  const el = cwdDisplay();
  if (el) el.textContent = getCwdDisplay();
}

function appendLine(text, color, isHTML = false) {
  const div = document.createElement("div");
  div.style.textAlign = "left";
  if (isHTML) {
    div.innerHTML = text;
  } else {
    div.textContent = text;
  }
  if (color) div.style.color = color;
  output().appendChild(div);
}

function printPrompt(cmdText) {
  const line = document.createElement("div");
  line.className = "space-y-1";
  line.innerHTML =
    '<div style="color:var(--theme-promptUser)">╭─' + tc.username + "@" + tc.hostname + ' <span style="color:var(--theme-info)">' + getCwdDisplay() + '</span></div>' +
    '<div style="color:var(--theme-promptUser)">╰─<span style="color:var(--theme-promptSymbol)">$ </span><span>' + (cmdText || '') + '</span></div>';
  output().appendChild(line);
}

// Vi mode helpers (set -o vi)
function setViMode(mode) {
  viMode = mode;
  if (mode === 'normal') viPending = '';
  document.querySelectorAll('.vi-mode-indicator').forEach(ind => {
    ind.textContent = mode === 'normal' ? '-- NORMAL --' : '';
    ind.style.display = mode === 'normal' ? '' : 'none';
  });
  const inp = inputEl();
  if (inp) {
    inp.style.caretColor = mode === 'normal' ? 'transparent' : '';
    inp.style.backgroundColor = mode === 'normal' ? 'var(--theme-welcomeBoxBg)' : '';
    if (mode === 'normal') viClampCursor();
  }
}

function viClampCursor() {
  const inp = inputEl();
  if (!inp) return;
  const len = inp.value.length;
  if (len === 0) { inp.setSelectionRange(0, 0); return; }
  const pos = Math.min(inp.selectionStart ?? len, len - 1);
  // Select the char under the cursor to simulate a vim block cursor
  inp.setSelectionRange(pos, pos + 1);
}

function viSetPos(p) {
  const inp = inputEl();
  if (!inp) return;
  p = Math.max(0, Math.min(p, inp.value.length - 1));
  inp.setSelectionRange(p, Math.min(p + 1, inp.value.length));
}

function handleViKey(e) {
  e.preventDefault();
  const inp = inputEl();
  const val = inp.value;
  const pos = inp.selectionStart;
  const k = e.key;

  // Pending 'd' operator: dd deletes the whole line
  if (viPending === 'd') {
    viPending = '';
    if (k === 'd') { inp.value = ''; viSetPos(0); }
    return;
  }

  if (k === 'h') { viSetPos(pos - 1); return; }
  if (k === 'l') { viSetPos(pos + 1); return; }
  if (k === 'k') { // older history (like ArrowUp)
    if (histIdx < history.length - 1) { histIdx++; inp.value = history[histIdx]; viClampCursor(); }
    return;
  }
  if (k === 'j') { // newer history (like ArrowDown)
    if (histIdx > 0) { histIdx--; inp.value = history[histIdx]; }
    else { histIdx = -1; inp.value = ''; }
    viClampCursor();
    return;
  }
  if (k === '0') { viSetPos(0); return; }
  if (k === '$') { viSetPos(val.length - 1); return; }
  if (k === '^') { viSetPos(val.search(/\S/)); return; }
  if (k === 'w') {
    const m = val.slice(pos).match(/^\S*\s*\S/);
    viSetPos(m ? pos + m[0].length - 1 : val.length - 1);
    return;
  }
  if (k === 'b') {
    const m = val.slice(0, pos).match(/\S(\s*\S)*$/);
    viSetPos(m ? m.index : 0);
    return;
  }
  if (k === 'i') { setViMode('insert'); return; }
  if (k === 'a') { setViMode('insert'); inp.setSelectionRange(pos + 1, pos + 1); return; }
  if (k === 'I') { setViMode('insert'); inp.setSelectionRange(0, 0); return; }
  if (k === 'A') { setViMode('insert'); inp.setSelectionRange(val.length, val.length); return; }
  if (k === 'x') {
    inp.value = val.slice(0, pos) + val.slice(pos + 1);
    viSetPos(pos);
    return;
  }
  if (k === 'D') {
    inp.value = val.slice(0, pos);
    viClampCursor();
    return;
  }
  if (k === 'd') { viPending = 'd'; return; }
}

function scroll() {
  const c = container();
  if (c) c.scrollTop = c.scrollHeight;
}

// Clickable file/dir rendering
function renderClickableEntry(entry, indent = 0) {
  const prefix = '  '.repeat(indent);
  const span = document.createElement('span');
  span.style.cursor = 'pointer';
  span.style.textAlign = 'left';
  
  if (entry.type === 'dir') {
    span.style.color = 'var(--theme-info)';
    span.textContent = prefix + entry.name + '/';
    span.title = 'Click to cd into ' + entry.name;
    span.addEventListener('click', () => {
      const newPath = cwd ? `${cwd}/${entry.name}` : entry.name;
      handleCommand(`cd "${newPath}"`);
    });
  } else {
    span.style.color = 'var(--theme-text)';
    span.textContent = prefix + entry.name;
    span.title = 'Click to preview ' + entry.name;
    span.addEventListener('click', () => {
      const fullPath = entry.path || (cwd ? `${cwd}/${entry.name}` : entry.name);
      openPreview(fullPath, entry.name);
    });
  }
  
  return span;
}

// Tab completion for file/directory names
// Returns all completion candidates for a partial path; [] if none
function completePathMatches(partial) {
  const node = findNode(cwd);
  if (!node || !Array.isArray(node)) return [];
  
  const lastSlash = partial.lastIndexOf('/');
  const dirPart = lastSlash >= 0 ? partial.substring(0, lastSlash + 1) : '';
  const namePart = lastSlash >= 0 ? partial.substring(lastSlash + 1) : partial;
  
  // Resolve the directory to search in
  let searchNode = node;
  if (dirPart) {
    const resolvedDir = resolvePath(dirPart.slice(0, -1));
    searchNode = findNode(resolvedDir);
    if (!searchNode || !Array.isArray(searchNode)) return [];
  }
  
  return searchNode
    .filter(n => n.name.startsWith(namePart))
    .map(n => dirPart + n.name + (n.type === 'dir' ? '/' : ''));
}

// Preview modal
function openPreview(filePath, fileName) {
  const modal = $("preview-modal");
  const filenameEl = $("preview-filename");
  const contentEl = $("preview-content");
  
  filenameEl.textContent = fileName;
  contentEl.innerHTML = '<div style="text-align:center;padding:2rem;color:var(--theme-muted);">Loading...</div>';
  modal.classList.remove('hidden');
  
  // Fetch raw markdown from static hosting (public/md/)
  const mdUrl = tc.mdBaseUrl + filePath.split('/').map(encodeURIComponent).join('/');
  fetch(mdUrl)
    .then(r => {
      if (!r.ok) throw new Error('File not found');
      return r.text();
    })
    .then(md => {
      if (window.__renderMarkdown) {
        window.__renderMarkdown(md, contentEl);
      } else {
        contentEl.textContent = md;
      }
      // Rewrite relative image/asset URLs to the MkDocs docs site
      const dir = filePath.includes('/') ? filePath.slice(0, filePath.lastIndexOf('/') + 1) : '';
      contentEl.querySelectorAll('img').forEach(img => {
        const src = img.getAttribute('src') || '';
        if (/^(https?:)?\/\//.test(src) || src.startsWith('data:') || src.startsWith('/')) return;
        img.src = tc.docsBaseUrl + (dir + decodeURIComponent(src)).split('/').map(encodeURIComponent).join('/');
      });
      contentEl.scrollTop = 0;
    })
    .catch(() => {
      contentEl.innerHTML = '<div style="color:var(--theme-error);padding:2rem;">Failed to load: ' + fileName + '</div>';
    });
}

function closePreview() {
  $("preview-modal").classList.add('hidden');
  const inp = inputEl();
  if (!inp) return;
  // Focus immediately and again on next tick in case Esc/click
  // caused a blur that lands after this handler
  inp.focus({ preventScroll: true });
  setTimeout(() => {
    if (document.activeElement !== inp) inp.focus({ preventScroll: true });
  }, 0);
}

// Command handlers
// Split a command line into tokens, honoring single/double quotes
function tokenize(str) {
  const tokens = [];
  let cur = '';
  let quote = null;
  for (const ch of str) {
    if (quote) {
      if (ch === quote) quote = null;
      else cur += ch;
    } else if (ch === '"' || ch === "'") {
      quote = ch;
    } else if (/\s/.test(ch)) {
      if (cur) { tokens.push(cur); cur = ''; }
    } else {
      cur += ch;
    }
  }
  if (cur) tokens.push(cur);
  return tokens;
}

function handleCommand(raw) {
  const cmd = raw.trim();
  if (!cmd) return;

  history.unshift(cmd);
  histIdx = -1;

  printPrompt(cmd);

  const parts = tokenize(cmd);
  const command = parts[0];
  const args = parts.slice(1);

  // Built-in commands
  if (command === "clear" || command === "cls") {
    output().innerHTML = "";
    return;
  }

  if (command === "help" || command === "h") {
    const lines = ["Available commands:", ""];
    const builtins = [
      ["help", "Show this help message"],
      ["clear", "Clear the terminal"],
      ["neofetch", "Display system information"],
      ["about", "About me"],
      ["whoami", "Who am I"],
      ["skills", "List my skills"],
      ["date", "Show current date"],
      ["pwd", "Print working directory"],
      ["ls", "List files in current directory"],
      ["ll", "List files in long format (ls -l)"],
      ["cd", "Change directory"],
      ["cat", "Preview a markdown file"],
      ["uptime", "Show uptime"],
    ];
    builtins.forEach(([k, v]) => lines.push("  " + k.padEnd(14) + "- " + v));
    lines.push("");
    lines.push("  vi mode: press Esc for normal mode (hjkl move, dd clear, x/D delete, A/I/a/i insert, w/b word, 0/$ line)");
    Object.entries(tc.customCommands).forEach(([k, v]) => {
      lines.push("  " + k.padEnd(14) + "- " + v.description);
    });
    lines.forEach(l => appendLine(l, "var(--theme-text)"));
    scroll();
    return;
  }

  if (command === "neofetch") {
    const lines = [
      "       .:'          " + tc.username + "@" + tc.hostname,
      "   _ :'_'           ---------------------",
      "  .'  _  `.",
      "  :   _   :          OS: macOS",
      "  :  (_)_  :          Host: " + tc.hostname,
      "  :   _    :          Shell: zsh",
      "  `.  _  .'          Terminal: browser",
      "    `.'",
    ];
    lines.forEach(l => appendLine(l, "var(--theme-primary)"));
    scroll();
    return;
  }

  if (command === "about" || command === "whoami") {
    ["Name: " + tc.username, "", "Welcome to my terminal portfolio!", "Type 'help' for commands.", "Type 'docs' to visit knowledge base."].forEach(l => appendLine(l, "var(--theme-text)"));
    scroll();
    return;
  }

  if (command === "skills") {
    appendLine("Skills & Technologies:", "var(--theme-primary)");
    appendLine("Java, Python, Linux, Docker", "var(--theme-text)");
    scroll();
    return;
  }

  if (command === "date") {
    appendLine(new Date().toString(), "var(--theme-text)");
    scroll();
    return;
  }

  if (command === "pwd") {
    appendLine("/home/" + tc.username + (cwd ? "/" + cwd : ""), "var(--theme-text)");
    scroll();
    return;
  }

  // ls command (ll = ls -l)
  if (command === "ls" || command === "ll") {
    const showLong = command === "ll" || args.includes('-l') || args.includes('-la');
    const targetArg = args.find(a => !a.startsWith('-'));
    // No argument: list current directory
    const resolvedPath = targetArg ? resolvePath(targetArg) : cwd;
    const node = findNode(resolvedPath);
    
    if (!node || !Array.isArray(node)) {
      appendLine(command + ": cannot access '" + (targetArg || '.') + "': No such file or directory", "var(--theme-error)");
      scroll();
      return;
    }

    if (showLong) {
      node.forEach(entry => {
        const type = entry.type === 'dir' ? 'drwxr-xr-x' : '-rw-r--r--';
        const size = entry.type === 'dir' ? '4096' : String(entry.size || 0);
        const name = entry.type === 'dir' ? entry.name + '/' : entry.name;
        const color = entry.type === 'dir' ? 'var(--theme-info)' : 'var(--theme-text)';
        appendLine(`${type}  ${size.padStart(8)}  ${name}`, color);
      });
    } else {
      const line = document.createElement('div');
      line.style.textAlign = 'left';
      node.forEach((entry, i) => {
        const clickable = renderClickableEntry(entry);
        line.appendChild(clickable);
        if (i < node.length - 1) {
          line.appendChild(document.createTextNode('  '));
        }
      });
      output().appendChild(line);
    }
    scroll();
    return;
  }

  // cd command
  if (command === "cd") {
    let target = args[0] || '';
    // Tolerate unquoted paths with spaces: cd Java 高级
    if (target && target !== '~' && args.length > 1 && !findNode(resolvePath(target))) {
      target = args.join(' ');
    }
    if (!target || target === '~') {
      cwd = '';
      updateCwdDisplay();
      return;
    }
    const resolvedPath = resolvePath(target);
    const node = findNode(resolvedPath);
    if (!node || !Array.isArray(node)) {
      appendLine("cd: " + target + ": No such directory", "var(--theme-error)");
      scroll();
      return;
    }
    cwd = resolvedPath;
    updateCwdDisplay();
    return;
  }

  // cat command
  if (command === "cat") {
    let target = args[0];
    if (!target) {
      appendLine("cat: missing file argument", "var(--theme-error)");
      scroll();
      return;
    }
    // Tolerate unquoted paths with spaces: cat 03.Session快速入门.md with dirs
    if (args.length > 1) {
      const first = findNode(resolvePath(target));
      if (!first || first.type !== 'file') target = args.join(' ');
    }
    const resolvedPath = resolvePath(target);
    const node = findNode(resolvedPath);
    if (!node || node.type !== 'file') {
      appendLine("cat: " + target + ": No such file", "var(--theme-error)");
      scroll();
      return;
    }
    openPreview(resolvedPath, node.name);
    return;
  }

  if (command === "uptime" || command === "uname") {
    appendLine("browser terminal - " + navigator.platform, "var(--theme-text)");
    scroll();
    return;
  }

  // Custom commands
  const custom = tc.customCommands[command];
  if (custom) {
    if (custom.action === "navigate" || custom.action === "external") {
      appendLine("Opening: " + custom.target, "var(--theme-primary)");
      window.open(custom.target, custom.action === "external" ? "_blank" : "_self");
    } else if (custom.output === "__function__") {
      if (command === "joke") {
        appendLine(JOKES[Math.floor(Math.random() * JOKES.length)], "var(--theme-text)");
      }
    } else if (Array.isArray(custom.output)) {
      custom.output.forEach(l => appendLine(l, "var(--theme-text)"));
    }
    scroll();
    return;
  }

  appendLine("command not found: " + command + ". Type 'help' for available commands.", "var(--theme-error)");
  scroll();
}

// Initialize
document.addEventListener("DOMContentLoaded", () => {
  const inp = inputEl();
  if (!inp) return;

  // Print welcome message
  tc.welcomeMessage.forEach(l => appendLine(l, "var(--theme-primary)"));
  appendLine(""); // blank line

  inp.focus();

  inp.addEventListener("keydown", (e) => {
    // Any non-Tab key invalidates the Tab-cycling state
    if (e.key !== 'Tab') tabState = null;
    if (e.key === "Escape") {
      // Modal open? Let the document-level handler close it
      if (!$("preview-modal").classList.contains("hidden")) return;
      e.preventDefault();
      if (viMode === 'insert') setViMode('normal');
      return;
    }
    if (viMode === 'normal' && !e.ctrlKey && !e.metaKey && !e.altKey) {
      handleViKey(e);
      return;
    }
    if (e.key === "Enter") {
      e.preventDefault();
      const val = inp.value;
      inp.value = "";
      handleCommand(val);
    } else if (e.key === "ArrowUp") {
      e.preventDefault();
      if (histIdx < history.length - 1) {
        histIdx++;
        inp.value = history[histIdx];
      }
    } else if (e.key === "ArrowDown") {
      e.preventDefault();
      if (histIdx > 0) {
        histIdx--;
        inp.value = history[histIdx];
      } else {
        histIdx = -1;
        inp.value = "";
      }
    } else if (e.key === "Tab") {
      e.preventDefault();
      const val = inp.value;
      if (!val) return;
      const tokens = val.split(/\s+/);
      if (tokens.length === 1) {
        // Completing command name
        const allCmds = ["help","clear","neofetch","about","whoami","skills","date","pwd","ls","ll","cd","cat","uptime","uname", ...Object.keys(tc.customCommands)];
        const matches = allCmds.filter(c => c.startsWith(tokens[0]));
        if (matches.length === 1) {
          inp.value = matches[0] + " ";
        } else if (matches.length > 1) {
          appendLine(matches.join("  "), "var(--theme-info)");
          scroll();
        }
        return;
      }
      // Completing path argument (last token), honor an open quote
      const quoteMatch = val.match(/(["'])((?:(?!\1).)*)$/);
      let prefix, lastToken, quote = '';
      if (quoteMatch) {
        quote = quoteMatch[1];
        lastToken = quoteMatch[2];
        prefix = val.substring(0, val.length - lastToken.length);
      } else {
        const tokens = val.split(/\s+/);
        lastToken = tokens[tokens.length - 1];
        prefix = val.substring(0, val.length - lastToken.length);
      }
      if (!lastToken) return;
      // tabState is cleared by any non-Tab key, so if it exists just cycle
      if (!tabState) {
        let candidates = completePathMatches(lastToken);
        if (!candidates.length && !quote) {
          // Merge preceding tokens to support unquoted paths with spaces
          const allTokens = val.split(/\s+/);
          for (let k = 2; k <= allTokens.length; k++) {
            const joined = allTokens.slice(-k).join(' ');
            const merged = completePathMatches(joined);
            if (merged.length) {
              lastToken = joined;
              prefix = val.substring(0, val.length - joined.length);
              candidates = merged;
              break;
            }
          }
        }
        if (!candidates.length) return;
        tabState = { prefix, quote, candidates, idx: -1, shown: false };
      }
      const st = tabState;
      st.idx = (st.idx + 1) % st.candidates.length;
      if (!st.shown && st.candidates.length > 1) {
        appendLine(st.candidates.join('  '), "var(--theme-info)");
        scroll();
        st.shown = true;
      }
      const completed = st.candidates[st.idx];
      const isDir = completed.endsWith('/');
      if (st.quote) {
        inp.value = st.prefix + completed + (isDir ? '' : st.quote);
      } else if (/\s/.test(completed)) {
        inp.value = st.prefix + '"' + completed + (isDir ? '' : '"');
      } else {
        inp.value = st.prefix + completed;
      }
    } else if (e.ctrlKey && e.key === "l") {
      e.preventDefault();
      output().innerHTML = "";
    }
  });

  // Keep focus on input when clicking terminal area
  container()?.addEventListener("click", (e) => {
    if (e.target === container() || e.target === output()) {
      inp.focus();
    }
  });

  // In normal mode, restore block cursor (single-char selection) after mouse clicks
  inp.addEventListener("mouseup", () => {
    if (viMode === 'normal') viClampCursor();
  });

  // Preview modal close handlers
  $("preview-close")?.addEventListener("click", closePreview);
  $("preview-modal")?.addEventListener("click", (e) => {
    if (e.target === $("preview-modal")) closePreview();
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && !$("preview-modal").classList.contains("hidden")) {
      closePreview();
    }
  });
});
</script>

<script>
  import { marked } from "marked";
  window.__renderMarkdown = (content, el) => {
    el.innerHTML = marked.parse(content);
  };
</script>
